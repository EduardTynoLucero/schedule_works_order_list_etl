TZ=America/Guatemala
CRON_EXPR=*/5 * * * *

# ========== LISTADO DE ORDENES (WORKS) ==========
ETL_MODE=PAGING_ONLY
#ETL_MODE=UPDATED_SINCE
ETL_RUN_ONCE=0
WORKS_PAGE_FROM=0
WORKS_FETCH_DETAILS_WHEN_MISSING_PATIENT=1
WORKS_DETAIL_CONCURRENCY=128
WORKS_DETAIL_ADAPTIVE=1
# consulta SIEMPRE el detalle: status, status_name y fecha de envio (delivery_note_date) para works y external_work_details
WORKS_FETCH_DETAIL_FOR_DELIVERY=1
# 0 = consultar SIEMPRE el detalle de todas las ordenes (funcionamiento normal); 1 = solo nuevas/cambiadas/abiertas
WORKS_DETAIL_ONLY_CHANGED=0
# ordenes abiertas (sin fecha de envio): re-consultar su detalle como maximo cada N minutos
WORKS_OPEN_RECHECK_MINUTES=30
# paginas del listado pedidas a la vez
WORKS_PAGE_CONCURRENCY=8
# detalles que se juntan antes de guardarlos en external_work_details
WORKS_DETAIL_SAVE_BATCH=500
# pausa entre paginas en ms
WORKS_PAGE_DELAY_MS=0
# PAGING_ONLY: aplicar a works cada N paginas (0 = solo al final)
WORKS_PARTIAL_UPSERT_EVERY_PAGES=0
# backfill de pacientes: no reintentar la misma orden antes de N horas
WORKS_BACKFILL_RETRY_HOURS=6
WORKS_BACKFILL_MISSING_PATIENTS=1
WORKS_BACKFILL_MISSING_PATIENTS_LIMIT=500
WORKS_ENABLE_SOFT_DELETE=1
WORKS_ENABLE_STALE_DELETE=1

# external_id de la orden a buscar (o varios separados por coma). Vacio = no busca.
WORKS_FIND_EXTERNAL_ID=

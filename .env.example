# ========== API ==========
API_BASE_URL=https://www.vevidental.com/dlabs/api/services/v1
API_TOKEN=

# ========== BD ==========
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=3306

TZ=America/Guatemala

# ========== LISTADO DE ORDENES (WORKS) ==========
# AUTO | UPDATED_SINCE | PAGING_ONLY  (DETAILS_ONLY ya no aplica aqui)
ETL_MODE=AUTO
# 0 = loop continuo (corre, espera 1 min, vuelve a correr) | 1 = una sola corrida
ETL_RUN_ONCE=0
# FORCE_UPDATED_SINCE=2026-09-01T00:00:00-06:00

WORKS_PAGING_ONLY=0
WORKS_PAGE_FROM=0
WORKS_PAGE_TO=3000
WORKS_PAGE_SIZE_STOP=50

WORKS_FETCH_DETAILS_WHEN_MISSING_PATIENT=1
WORKS_DETAIL_CONCURRENCY=2
WORKS_BACKFILL_MISSING_PATIENTS=1
WORKS_BACKFILL_MISSING_PATIENTS_LIMIT=500

WORKS_ENABLE_SOFT_DELETE=1
